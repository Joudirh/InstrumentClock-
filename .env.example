# Neon Postgres
# Pooled connection (host contains "-pooler") - used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct/unpooled connection (same host without "-pooler") - used by the Prisma CLI.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Object Storage (S3-compatible). Generate a credential in the Neon console.
AWS_ENDPOINT_URL_S3="https://<bucket-id>.storage.<region>.aws.neon.tech"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
S3_BUCKET="assets"

# Gemini course generation (server-side only)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
